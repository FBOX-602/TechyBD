# Put real values in .env.local for development and in Vercel Project Settings for deployment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Use at least 32 random characters. Example: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret

# Set false only for a local database that does not use TLS.
# DATABASE_SSL=false
# ADMIN_SESSION_TTL_HOURS=12
